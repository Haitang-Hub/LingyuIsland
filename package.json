{
  "name": "@haitang-hub/lingyu-island",
  "productName": "灵屿岛",
  "version": "1.3.2",
  "description": "灵动岛式文件屏蔽与恢复工具：拖入文件即可屏蔽个人敏感信息，随时还原",
  "main": "src/main/main.js",
  "author": "Haitang-Hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haitang-Hub/LingyuIsland.git"
  },
  "files": [
    "src",
    "assets",
    "scripts",
    "test/e2e.js",
    "test/e2e-src",
    "test/real-files.test.js",
    "test/run-tests.js",
    "README.md",
    "启动灵屿岛.bat",
    "启动灵屿岛.command"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "e2e": "cross-env-shell ISLAND_E2E=1 electron . || ISLAND_E2E=1 electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.lingyu.privacy-island",
    "productName": "LingyuIsland",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!test/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "灵屿岛",
      "artifactName": "LingyuIsland-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "jimp": "^1.6.1"
  }
}
