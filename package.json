{
  "name": "@haitang-hub/lingyu-island",
  "productName": "灵屿岛",
  "version": "1.15.0",
  "description": "灵动岛式文件屏蔽与恢复工具：拖入文件即可屏蔽个人敏感信息，随时还原",
  "main": "src/main/main.js",
  "author": "Haitang-Hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haitang-Hub/LingyuIsland.git"
  },
  "files": [
    "src",
    "assets",
    "scripts",
    "test/e2e.js",
    "test/e2e-src",
    "test/real-files.test.js",
    "test/run-tests.js",
    "README.md",
    "启动灵屿岛.bat",
    "启动灵屿岛.command"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js && node test/regression.test.js",
    "test:core": "node test/run-tests.js",
    "test:regress": "node test/regression.test.js",
    "test:real": "node test/real-files.test.js",
    "e2e": "cross-env-shell ISLAND_E2E=1 electron . || ISLAND_E2E=1 electron .",
    "test:e2e": "cross-env-shell ISLAND_E2E=1 electron . || ISLAND_E2E=1 electron .",
    "dist": "node scripts/dist.js",
    "clean:release": "node scripts/dist.js --clean-only"
  },
  "build": {
    "appId": "com.lingyu.privacy-island",
    "productName": "LingyuIsland",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/engine/**/*",
      "package.json",
      "!test/**"
    ],
    "electronLanguages": [
      "zh-CN"
    ],
    "extraResources": [
      {
        "from": "assets/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/legacy/build/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/@napi-rs/canvas/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "灵屿岛",
      "artifactName": "LingyuIsland-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cnb.cool/haitang.hub/LingyuIsland/-/releases/latest/download",
        "useMultipleRangeRequest": false
      }
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "iconv-lite": "^0.6.3",
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "jimp": "^1.6.1"
  }
}
